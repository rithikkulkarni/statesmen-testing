{
  "version": 2,
  "datasetId": "payments",
  "columns": {
    "order": [
      "customer",
      "carrier",
      "amount",
      "status",
      "paymentMethod",
      "invoiceDate",
      "region",
      "paymentId",
      "policyNumber"
    ],
    "hidden": [
      "policyNumber"
    ],
    "pinned": {
      "customer": "left"
    },
    "widths": {
      "customer": 250,
      "amount": 170
    }
  },
  "sort": [
    {
      "field": "amount",
      "direction": "desc"
    },
    {
      "field": "invoiceDate",
      "direction": "asc"
    }
  ],
  "filters": {
    "status": {
      "operator": "equals",
      "value": "Paid"
    },
    "amount": {
      "operator": "between",
      "value": [1000, 5000]
    }
  },
  "groupBy": [
    "carrier",
    "region"
  ],
  "aggregations": {
    "amount": "sum"
  },
  "subtotals": {
    "enabled": true,
    "position": "bottom"
  }
}
